---
import ServiceHero from "@/components/common/ServiceHero.astro";
import Layout from "@/layouts/Layout.astro";
import InfoBlock from "@/components/common/InfoBlock.astro";
import CardsFlowList from "@/components/common/CardsFlowList.astro";
import BenefitsCard from "@/components/common/BenefitsCard.astro";
import creatorsImage from "@/assets/images/services/creators.png";
import cardMgGlassImage from "@/assets/images/services/cards-mg-glass.png";
import cardHeartImage from "@/assets/images/services/cards-heart-pulse.png";
import cardDiagramImage from "@/assets/images/services/cards-gypsy-diagram.png";
import cardDialogsImage from "@/assets/images/services/cards-dialogs.png";
import cubeImage from "@/assets/images/cube.png";
import diamondImage from "@/assets/images/diamond.png";
import Section from "@/components/common/Section.astro";
import CallToAction from "@/components/common/CallToAction.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout>
  <ServiceHero
    title={t("auto-support.headline")}
    subtitle={t("auto-support.description")}
    image={creatorsImage}
    items={[
      t("auto-support.head-feature.1"),
      t("auto-support.head-feature.2"),
      t("auto-support.head-feature.3"),
    ]}
  />
  <InfoBlock
    title={t("auto-support.info.title")}
    subtitle={t("auto-support.info.description")}
    className="my-10"
  />

  <Section title={t("auto-support.process.title")} sectionId="support-process">
    <p slot="description" class="md:max-w-2xl">
      {t("auto-support.process.description")}
    </p>
    <CardsFlowList
      cards={[
        {
          title: t("auto-support.process.step.1.title"),
          subtitle: t("auto-support.process.step.1.description"),
          image: cardMgGlassImage,
        },
        {
          title: t("auto-support.process.step.2.title"),
          subtitle: t("auto-support.process.step.2.description"),
          image: cardHeartImage,
        },
        {
          title: t("auto-support.process.step.3.title"),
          subtitle: t("auto-support.process.step.3.description"),
          image: cardDiagramImage,
        },
        {
          title: t("auto-support.process.step.4.title"),
          subtitle: t("auto-support.process.step.4.description"),
          image: cardDialogsImage,
        },
      ]}
    />
  </Section>

  <Section title={t("auto-support.plans.title")} sectionId="support-plans">
    <p slot="description" class="md:max-w-2xl">
      {t("auto-support.plans.description")}
    </p>

    <div
      class="flex w-full flex-col items-center justify-between gap-6 md:flex-col lg:flex-row"
    >
      <BenefitsCard
        title={t("auto-support.plans.standard.title")}
        items={[
          t("auto-support.plans.standard.1"),
          t("auto-support.plans.standard.2"),
          t("auto-support.plans.standard.3"),
        ]}
        image={cubeImage}
      />
      <BenefitsCard
        title={t("auto-support.plans.premium.title")}
        isDark
        items={[
          t("auto-support.plans.premium.1"),
          t("auto-support.plans.premium.2"),
          t("auto-support.plans.premium.3"),
          t("auto-support.plans.premium.4"),
        ]}
        image={diamondImage}
      />
    </div>
  </Section>

  <CallToAction
    title="Потрібна підтримка автоматизації?"
    buttonLabel="Запросити підтримку"
  >
    <p slot="description" class="max-w-lg text-lg">
      Давайте обговоримо, як ми можемо підтримувати ваші системи на максимальній
      продуктивності за допомогою експертного обслуговування, постійного
      моніторингу та оновлень продуктивності.
    </p>
  </CallToAction>
</Layout>
