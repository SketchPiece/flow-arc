---
import Layout from "@/layouts/Layout.astro";
import Heading from "@/components/blog/Heading.astro";
import { getCollection } from "astro:content";
import PostCard from "@/components/blog/PostCard.astro";
import PostsContainer from "@/components/blog/PostsContainer.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import { truncate, mapNotionPost } from "@/lib/helpers";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const blog = await getCollection("blog", ({ data }) => {
  const isDraft = data.properties.Draft?.checkbox === true;
  const isCurrentLang =
    !data.properties.Lang?.select?.name ||
    data.properties.Lang.select.name === lang;
  return !isDraft && isCurrentLang;
});
---

<Layout
  title={t("seo.blog.title")}
  description={t("seo.blog.description")}
>
  <Heading
    title={t("blog.title")}
    description={t("blog.description")}
  />
  <PostsContainer>
    {
      blog
        .map(mapNotionPost)
        .map((post) => (
          <PostCard
            slug={post.slug}
            title={post.title}
            image={post.image ?? "https://placehold.co/600x400/png"}
            description={truncate(post.description || "", 100)}
          />
        ))
    }
  </PostsContainer>
</Layout>
