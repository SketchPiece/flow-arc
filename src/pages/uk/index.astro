---
import CallToAction from "@/components/common/CallToAction.astro";
import CaseStudies from "@/components/home/CaseStudies.astro";
import ContactUs from "@/components/home/ContactUs.astro";
import Hero from "@/components/home/Hero.astro";
import Services from "@/components/home/Services.astro";
import WorkingProcess from "@/components/home/WorkingProcess.astro";
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout>
  <Hero />
  <Services />
  <CallToAction title={t("services.cta.title")}>
    <p slot="description" class="max-w-lg">
      <!-- Ready to transform your business? <b>Contact us today</b> to discover how our
      custom automation solutions can save you time, reduce costs, and accelerate
      your growth.
      <br />
      <br />
      Let us help you work smarter—not harder. -->
      {t("services.cta.description")}
    </p>
  </CallToAction>
  <CaseStudies />
  <WorkingProcess />
  <ContactUs />
</Layout>
