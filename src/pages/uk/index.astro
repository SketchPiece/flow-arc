---
import CallToAction from "@/components/common/CallToAction.astro";
import CaseStudies from "@/components/home/CaseStudies.astro";
import ContactUs from "@/components/home/ContactUs.astro";
import Hero from "@/components/home/Hero.astro";
import Services from "@/components/home/Services.astro";
import WorkingProcess from "@/components/home/WorkingProcess.astro";
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout>
  <Hero />
  <Services>
    <Fragment slot="web-dev-title">
      <span class="block w-fit rounded-md bg-grey-light px-2">Створення</span>
      <span class="block w-fit rounded-md bg-grey-light px-2">
        Веб-Застосунків
      </span>
    </Fragment>
  </Services>
  <CallToAction
    title={t("services.cta.title")}
    buttonLabel={t("common.cta")}
    type="chess"
  >
    <div slot="description" class="max-w-lg">
      <p>
        Готові вивести бізнес на новий рівень? <b>Зв'яжіться з нами</b> зараз!
      </p>
      <p class="mt-2">
        Ми допоможемо вам працювати ефективніше та досягати більших результатів
        з меншими зусиллями.
      </p>
    </div>
  </CallToAction>
  <CaseStudies />
  <WorkingProcess />
  <ContactUs />
</Layout>
