---
import Layout from "@/layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import notFound from "@/assets/icons/not-found.svg";
import { NotFoundSection } from "@/components/react/NotFoundSection";
import { getLangFromUrl } from "@/i18n/helpers";

const lang = getLangFromUrl(Astro.url);
---

<Layout>
  <div class="container mx-auto py-12 md:py-40 grid place-items-center">
      <Image
        src={notFound}
        alt="Hero Robot Preview"
        width={400}
        height={320}
      />
      <NotFoundSection client:load lang={lang} />
  </div>
</Layout>
