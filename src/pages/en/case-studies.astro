---
import Layout from "@/layouts/Layout.astro";
import Heading from "@/components/blog/Heading.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import CasesContainer from "@/components/cases/CasesContainer.astro";
import CaseCard from "@/components/cases/CaseCard.astro";
import { truncate, mapSanityCase, urlFor } from "@/lib/helpers";
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import { CASES_QUERY } from "@/sanity/queries";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cases = await sanityClient.fetch<SanityDocument[]>(CASES_QUERY(lang));
---

<Layout
  title={t("seo.case-studies.title")}
  description={t("seo.case-studies.description")}
>
  <Heading
    title={t("page.case-studies.title")}
    description={t("page.case-studies.description")}
  />
  <CasesContainer>
    {
      cases
        .map(mapSanityCase)
        .map((casePost) => (
          <CaseCard
            slug={casePost.slug}
            title={casePost.title}
            description={truncate(casePost.description || "", 100)}
            image={urlFor(casePost.image)?.width(600).height(600).url()}
          />
        ))
    }
  </CasesContainer>
</Layout>
