---
import Layout from "@/layouts/Layout.astro";
import Heading from "@/components/blog/Heading.astro";
import PostCard from "@/components/blog/PostCard.astro";
import PostsContainer from "@/components/blog/PostsContainer.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import { truncate, mapSanityPost } from "@/lib/helpers";
import { sanityClient } from "sanity:client";
import type { SanityDocument } from "@sanity/client";
import { BLOG_POSTS_QUERY } from "@/sanity/queries";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await sanityClient.fetch<SanityDocument[]>(BLOG_POSTS_QUERY(lang));
---

<Layout
  title={t("seo.blog.title")}
  description={t("seo.blog.description")}
>
  <Heading
    title={t("blog.title")}
    description={t("blog.description")}
  />
  <PostsContainer>
    {
      posts
        .map(mapSanityPost)
        .map((post) => (
          <PostCard
            slug={post.slug}
            title={post.title}
            image={post.image ?? "https://placehold.co/600x400/png"}
            description={truncate(post.description || "", 100)}
          />
        ))
    }
  </PostsContainer>
</Layout>
