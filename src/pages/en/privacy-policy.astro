---
import CallToAction from "@/components/common/CallToAction.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import Layout from "@/layouts/Layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t("seo.privacy-policy.title")}
  description={t("seo.privacy-policy.description")}
>
  <article
    class="container prose-lg mx-auto my-20 w-screen prose-headings:font-medium"
  >
    <h1>FlowArc Studio Privacy Policy</h1>

    <section>
      <h2>1. General Provisions</h2>
      <p>
        1.1. This Privacy Policy (hereinafter referred to as the "Policy")
        defines the procedure for processing and protecting personal data of
        users of the FlowArc Studio website (hereinafter referred to as the
        "Website").
      </p>
      <p>
        1.2. By using the Website and FlowArc Studio services (hereinafter
        referred to as the "Company"), you agree to the terms of this Policy.
      </p>
      <p>
        1.3. This Policy is developed in accordance with the Law of Ukraine "On
        Personal Data Protection" and other legal regulations of Ukraine.
      </p>
    </section>
    <section>
      <h2>2. What Data We Collect</h2>
      <p>2.1. When using the Website, we may collect:</p>
      <ul>
        <li>
          <strong>Personal Data:</strong>
          <ul>
            <li>First and last name</li>
            <li>Contact phone number</li>
            <li>Email address</li>
            <li>Company name (if applicable)</li>
            <li>Position (if applicable)</li>
          </ul>
        </li>
        <li>
          <strong>Technical Data:</strong>
          <ul>
            <li>IP address</li>
            <li>Browser type and version</li>
            <li>Device type</li>
            <li>Operating system</li>
            <li>Page visit data</li>
            <li>Time spent on the Website</li>
          </ul>
        </li>
      </ul>
    </section>
    <section>
      <h2>3. How We Use Your Data</h2>
      <ul>
        <li>Providing web development and automation services</li>
        <li>Communication regarding ordered services</li>
        <li>Sending commercial offers (with consent)</li>
        <li>Improving service quality</li>
        <li>Analyzing Website usage</li>
        <li>Technical support</li>
      </ul>
    </section>
    <section>
      <h2>4. Legal Basis for Data Processing</h2>
      <p>4.1. We process your personal data based on:</p>
      <ul>
        <li>Your consent</li>
        <li>Performance of contractual obligations</li>
        <li>The legitimate interests of the Company</li>
        <li>Compliance with legal requirements</li>
      </ul>
    </section>
    <section>
      <h2>5. Data Protection</h2>
      <p>
        5.1. We take necessary technical and organizational measures to protect
        your data, including:
      </p>
      <ul>
        <li>Data encryption</li>
        <li>Restricted access to personal data</li>
        <li>Regular security monitoring</li>
        <li>Staff training on data protection</li>
      </ul>
    </section>
    <section>
      <h2>6. Data Transfer to Third Parties</h2>
      <ul>
        <li>Company employees for providing services</li>
        <li>Contractors assisting in service delivery</li>
        <li>Government authorities as required by law</li>
      </ul>
    </section>
    <section>
      <h2>7. Cookies</h2>
      <p>7.1. Our Website uses cookies for:</p>
      <ul>
        <li>Analyzing Website usage</li>
        <li>Improving functionality</li>
        <li>Saving user preferences</li>
      </ul>
      <p>7.2. You can disable cookies in your browser settings.</p>
    </section>
    <section>
      <h2>8. Your Rights</h2>
      <p>8.1. According to legislation, you have the right to:</p>
      <ul>
        <li>Access information about your data processing</li>
        <li>Obtain a copy of your data</li>
        <li>Request correction of inaccurate data</li>
        <li>Request data deletion</li>
        <li>Restrict data processing</li>
        <li>Withdraw consent for data processing</li>
      </ul>
    </section>
    <section>
      <h2>9. Data Retention</h2>
      <p>9.1. We retain your data for:</p>
      <ul>
        <li>The duration of service provision</li>
        <li>The time necessary to achieve processing purposes</li>
        <li>The period specified by law</li>
      </ul>
    </section>
    <section>
      <h2>10. Policy Updates</h2>
      <p>
        10.1. We may update this Policy. The current version is always available
        on the Website.
      </p>
    </section>
    <section>
      <h2>11. Contact Information</h2>
      <p>11.1. For questions regarding personal data processing, contact:</p>
      <ul>
        <li>Email: <a href="mailto:contact@flowarc.dev" class="underline">contact@flowarc.dev</a></li>
        <li>Phone: <a href="https://wa.me/380XXXXXXXXX" class="underline">+380XXXXXXXXX (WhatsApp)</a></li>
      </ul>
      <p class="mt-10 font-bold">Last updated: 08.01.2025</p>
    </section>
  </article>
  <CallToAction title="Need Automation Support?" buttonLabel="Request Support">
    <p slot="description" class="max-w-lg text-lg">
      Let’s discuss how we can help keep your systems running at peak
      performance with expert maintenance, continuous monitoring, and
      performance updates.
    </p>
  </CallToAction>
</Layout>
