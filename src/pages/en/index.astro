---
import CallToAction from "@/components/common/CallToAction.astro";
import CaseStudies from "@/components/home/CaseStudies.astro";
import ContactUs from "@/components/home/ContactUs.astro";
import Hero from "@/components/home/Hero.astro";
import Services from "@/components/home/Services.astro";
import WorkingProcess from "@/components/home/WorkingProcess.astro";
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import { getCasesCollection } from "@/lib/content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featuredStudies = await getCasesCollection({ lang, featured: true });

const featuredStudyLinks = featuredStudies.map((study) => {
  return {
    title: study.title,
    description: study.description,
    href: `/${lang}/case-studies/${study.slug}`,
  };
});
---

<Layout
  title={t("seo.home.title")}
  description={t("seo.home.description")}
>
  <Hero />
  <Services />
  <CallToAction
    title={t("services.cta.title")}
    buttonLabel={t("common.cta")}
    type="chess"
  >
    <div slot="description" class="max-w-lg">
      <p slot="description" class="max-w-lg">
        Ready to transform your business? <b>Contact us today</b> to discover how
        our custom automation solutions can save you time, reduce costs, and accelerate
        your growth.
        <br />
        <br />
        Let us help you work smarter—not harder.
      </p>
    </div>
  </CallToAction>
  <CaseStudies cases={featuredStudyLinks} />
  <WorkingProcess />
  <ContactUs />
</Layout>
