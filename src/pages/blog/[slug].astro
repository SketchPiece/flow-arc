---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getBlogPostBySlug, getBlogPosts } from "../../api/posts";

export function getStaticPaths() {
  return getBlogPosts().map((post) => ({
    params: { slug: String(post?.id) },
  }));
}

const { slug } = Astro.params;

const post = getBlogPostBySlug(slug);

if (!post) {
  throw new Error(`No post by id "${slug}"`);
}
---

<Layout>
  <section id="post-title" class="container mx-auto pb-36 pt-20">
    <h1 class="mb-8 text-4xl font-medium md:text-6xl">
      {post.title}
    </h1>
    <Image
      src={post.image}
      alt={`${post.id}-post-image`}
      class="shadow-straight mb-16 h-[330px] w-full rounded-smooth-large object-cover"
      width="120"
      height="330"
    />
    <div class="flex flex-col gap-4 md:px-20 lg:px-60">
      <p class="text- text-lg font-medium">{post.readingTime}</p>
      {post?.paragraphs?.map((p) => <p class="text-lg">{p}</p>)}
    </div>
  </section>
</Layout>
