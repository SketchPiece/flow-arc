---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getBlogPosts } from "../../lib/helpers";



export function getStaticPaths() {
   return getBlogPosts().map((post) => ({
    params: { id: String(post?.id) }, 
  }));
}

const { id } = Astro.params;

const post = getBlogPosts()?.find((p) => p.id === id);

if (!post) {
  throw new Error(`No post by id "${id}"`);
}
---

<Layout>
    <section id="post-title" class="container mx-auto pt-20 pb-36">
        <h1 class="text-4xl md:text-6xl font-medium mb-8">
        {post.title}
        </h1>
        <Image src={post.image} alt={`${post.id}-post-image`} class="w-full h-[330px] mb-16 object-cover rounded-smooth-large" width="120" height="330" />
        <div class="md:px-20 lg:px-60 flex flex-col gap-5">
            {post?.descriptionParagraphs?.map((p) => <p class="text-lg">{p}</p>)}
        </div>
    </section>
</Layout>
