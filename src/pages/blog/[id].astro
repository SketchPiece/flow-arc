---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getBlogPosts } from "../../lib/helpers";

export function getStaticPaths() {
  return getBlogPosts().map((post) => ({
    params: { id: String(post?.id) },
  }));
}

const { id } = Astro.params;

const post = getBlogPosts()?.find((p) => p.id === id);

if (!post) {
  throw new Error(`No post by id "${id}"`);
}
---

<Layout>
  <section id="post-title" class="container mx-auto pb-36 pt-20">
    <h1 class="mb-8 text-4xl font-medium md:text-6xl">
      {post.title}
    </h1>
    <Image
      src={post.image}
      alt={`${post.id}-post-image`}
      class="mb-16 h-[330px] w-full rounded-smooth-large object-cover"
      width="120"
      height="330"
    />
    <div class="flex flex-col gap-5 md:px-20 lg:px-60">
      {post?.descriptionParagraphs?.map((p) => <p class="text-lg">{p}</p>)}
    </div>
  </section>
</Layout>
