---
import ContentContainer from "@/components/common/ContentContainer.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import { defaultLang } from "@/i18n/translations";
import Layout from "@/layouts/Layout.astro";
import { mapNotionCase } from "@/lib/helpers";
import { render } from "astro:content";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const cases = await getCollection("cases");
  return cases
    .map((caseStudy) => ({
      params: {
        slug:
          caseStudy.data.properties.Slug?.rich_text[0]?.plain_text ||
          caseStudy.id,
        lang: caseStudy.data.properties.Lang?.select?.name || defaultLang,
      },
      props: { caseStudy },
    }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { caseStudy } = Astro.props;
const postData = mapNotionCase(caseStudy);

const title = postData.title;
const { Content } = await render(caseStudy);
---

<Layout
  title={title}
  description={postData.description || t("seo.case-studies.description")}
>
  <section id="post-title" class="container mx-auto pb-36 pt-20">
    <h1 class="mb-8 text-3xl font-medium md:text-5xl">
      {title}
    </h1>
    <div class="flex flex-col gap-4">
      <ContentContainer>
        <Content />
      </ContentContainer>
    </div>
  </section>
</Layout>
