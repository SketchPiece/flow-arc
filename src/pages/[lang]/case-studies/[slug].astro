---
import ContentContainer from "@/components/common/ContentContainer.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import Layout from "@/layouts/Layout.astro";
import { mapSanityCase } from "@/lib/helpers";
import { PortableText } from "astro-portabletext";
import { sanityClient } from "sanity:client";
import type { SanityDocument } from "@sanity/client";
import { CASE_SLUGS_QUERY, CASE_QUERY } from "@/sanity/queries";
import Type from "@/sanity/portabletext/Type.astro";

export async function getStaticPaths(): Promise<({ params: { slug: string; lang: string } })[]> {
  return await sanityClient.fetch(CASE_SLUGS_QUERY, Astro.params);
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const casePost = await sanityClient.fetch<SanityDocument>(CASE_QUERY(lang), Astro.params);
const caseData = mapSanityCase(casePost);

const title = caseData.title;
---

<Layout
  title={title}
  description={caseData.description || t("seo.case-studies.description")}
>
  <section id="post-title" class="container mx-auto pb-36 pt-20">
    <h1 class="mb-8 text-3xl font-medium md:text-5xl">
      {title}
    </h1>
    <div class="flex flex-col gap-4">
      <ContentContainer>
         {Array.isArray(caseData.content) && <PortableText value={caseData.content} components={{ type: Type }} />}
      </ContentContainer>
    </div>
  </section>
</Layout>
