---
import ContentContainer from "@/components/common/ContentContainer.astro";
import { useTranslations } from "@/i18n/helpers";
import Layout from "@/layouts/Layout.astro";
import { mapSanityPost, urlFor } from "@/lib/helpers";
import Type from "@/sanity/lib/portabletext/Type.astro";
import { BLOG_POST_QUERY, BLOG_SLUGS_QUERY } from "@/sanity/lib/queries";
import type { SanityDocument } from "@sanity/client";
import { PortableText } from "astro-portabletext";
import { Image } from "astro:assets";
import { sanityClient } from "sanity:client";

export async function getStaticPaths(): Promise<({ params: { slug: string; lang: "en" | "uk" } })[]> {
  return await sanityClient.fetch(BLOG_SLUGS_QUERY);
}

const { lang } = Astro.params
const t = useTranslations(lang);

const post = await sanityClient.fetch<SanityDocument>(BLOG_POST_QUERY(lang), Astro.params);

const postData = mapSanityPost(post);
const title = postData.title;
const readingTime = postData.readingTime;
---

<Layout
  title={title}
  description={postData.description || t("seo.blog.description")}
>
  <section id="post-title" class="container mx-auto pb-36 pt-20">
    <h1 class="mb-8 text-4xl font-medium md:text-6xl">
      {title}
    </h1>
    <Image
      src={urlFor(postData.image)?.width(900).height(700).url() ?? "https://placehold.co/600x400/png"}
      alt={`${post.id}-post-image`}
      class="mb-16 h-[330px] w-full rounded-smooth-large object-cover shadow-straight"
      width="1150"
      height="300"
    />
    <div class="flex flex-col gap-4 md:px-20 lg:px-40">
      {
        readingTime && (
          <p class="font-medium text-gray-dark">{readingTime} min read</p>
        )
      }
      <ContentContainer>
         {Array.isArray(postData.content) && <PortableText value={postData.content} components={{ type: Type }} />}
      </ContentContainer>
    </div>
  </section>
</Layout>
