---
import ContentContainer from "@/components/common/ContentContainer.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import Layout from "@/layouts/Layout.astro";
import { mapSanityPost } from "@/lib/helpers";
import Type from "@/sanity/portabletext/Type.astro";
import { BLOG_POST_QUERY, BLOG_SLUGS_QUERY } from "@/sanity/queries";
import type { SanityDocument } from "@sanity/client";
import { PortableText } from "astro-portabletext";
import { Image } from "astro:assets";
import { sanityClient } from "sanity:client";

export async function getStaticPaths(): Promise<({ params: { slug: string; lang: string } })[]> {
  return await sanityClient.fetch(BLOG_SLUGS_QUERY, Astro.params);
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// const { post } = Astro.props;
// const postData = mapNotionPost(post);

// const title = postData.title;
// const readingTime = postData.readingTime;
// const { Content } = await render(post);

const post = await sanityClient.fetch<SanityDocument>(BLOG_POST_QUERY(lang), Astro.params);
const postData = mapSanityPost(post);
const title = postData.title;
const readingTime = postData.readingTime;
---

<Layout
  title={title}
  description={postData.description || t("seo.blog.description")}
>
  <section id="post-title" class="container mx-auto pb-36 pt-20">
    <h1 class="mb-8 text-4xl font-medium md:text-6xl">
      {title}
    </h1>
    <Image
      src={postData.image ?? "https://placehold.co/600x400/png"}
      alt={`${post.id}-post-image`}
      class="mb-16 h-[330px] w-full rounded-smooth-large object-cover shadow-straight"
      width="1150"
      height="300"
    />
    <div class="flex flex-col gap-4 md:px-20 lg:px-40">
      {
        readingTime && (
          <p class="font-medium text-gray-dark">{readingTime} min read</p>
        )
      }
      <ContentContainer>
         {Array.isArray(postData.content) && <PortableText value={postData.content} components={{ type: Type }} />}
      </ContentContainer>
    </div>
  </section>
</Layout>
