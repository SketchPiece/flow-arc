---
import linkArrowFill from "@/assets/icons/link-arrow-fill.svg";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import { Image } from "astro:assets";

interface Props {
  slug: string;
  title: string;
  description: string | undefined;
  image: string;
}

const { slug, title, description, image } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<a href={`/${lang}/blog/${slug}`}>
  <article class="h-full">
    <div
      class="shadow-straight hover:shadow-straight-reduced flex h-full flex-col-reverse overflow-hidden rounded-smooth-large border border-grey-darkest bg-primary transition-all hover:-translate-y-1 sm:flex-col-reverse md:flex-row"
    >
      <div class="flex flex-col justify-between px-10 py-8 font-serif">
        <div>
          <h3 class="text-xl font-medium md:text-2xl">{title}</h3>
          <p class="mt-2.5 text-sm">
            {description}
          </p>
        </div>
        <div
          class="mt-5 flex items-center bg-transparent p-0 text-grey-darkest"
        >
          <img
            alt="Link icon"
            src={linkArrowFill.src}
            class="mr-3.5 h-10 w-10"
          />
          {t("blog.read-more")}
        </div>
      </div>
      <div class="w-full bg-grey-darkest sm:w-full">
        <Image
          src={image}
          alt="image-blog-card"
          class="h-full w-full rounded-r-smooth-large object-cover"
          width="120"
          height="200"
        />
      </div>
    </div>
  </article>
</a>
