---
import linkArrowFill from "../../assets/icons/link-arrow-fill.svg";
import { Image } from "astro:assets";

interface Props {
  id: string;
  title: string;
  description: string;
  image: string;
  className?: string;
}

const { id, title, description, image } = Astro.props;
---

<article id={id} class="shadow-straight h-fit w-full">
  <div
    class="flex h-full overflow-hidden rounded-smooth-large border border-grey-darkest bg-primary sm:flex-col-reverse md:flex-row xs:flex-col-reverse"
  >
    <div
      class="flex w-2/3 flex-col gap-2.5 px-10 py-8 font-serif sm:w-full xs:h-2/3 xs:w-full"
    >
      <h3 class="text-2xl font-medium">{title}</h3>
      <p class="text-sm">
        {description}
      </p>
      <a
        href={`/blog/${id}`}
        class="flex items-center bg-transparent p-0 text-grey-darkest md:mt-5"
      >
        <img alt="Link icon" src={linkArrowFill.src} class="mr-3.5 h-10 w-10" />
        Read more
      </a>
    </div>
    <div
      class="w-1/3 bg-grey-darkest sm:aspect-[16/9] sm:w-full xs:h-[150px] xs:w-full"
    >
      <Image
        src={image}
        alt={`image-blog-card-${id}`}
        class="h-full w-full rounded-r-smooth-large object-cover"
        width="120"
        height="200"
      />
    </div>
  </div>
</article>
