---
import PostCard from "./PostCard.astro";
import Button from "../react/ui/Button";
import type { Post } from "@/api/posts";
import { truncate } from "@/lib/helpers";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<section id="blog-posts" class="container mx-auto pb-28 pt-14">
  <div class="grid gap-10 sm:grid-cols-1 md:grid-cols-2 xs:grid-cols-1">
    {
      posts.map(({ paragraphs, ...post }) => (
        <PostCard
          {...post}
          description={truncate(String(paragraphs[0]), 110)}
        />
      ))
    }
  </div>
  <div class="mt-20 flex justify-between">
    <Button>Previous</Button>
    <Button>Next</Button>
  </div>
</section>
