---
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="blog-heading" class="container mx-auto pt-20">
  <h1 class="text-6xl font-medium">{t("blog.title")}</h1>
  <p class="mt-6 max-w-lg text-lg">{t("blog.description")}</p>
</section>
