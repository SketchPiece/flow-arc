---
import Button from "../react/ui/Button";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="blog-posts" class="container mx-auto pb-24 pt-12">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
    <slot />
  </div>
  <div class="mt-12 flex justify-between">
    <Button>{t("blog.previous")}</Button>
    <Button>{t("blog.next")}</Button>
  </div>
</section>
