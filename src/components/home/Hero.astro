---
import { Image } from "astro:assets";
import Button from "../react/ui/Button";
import RiveAnimation from "../react/RiveAnimation";
import heroRobotPreview from "@/assets/images/hero-robot.png";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import { cn } from "@/lib/helpers";
import { ServicesCarousel } from "../react/ServicesCarousel";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="hero"
  class="container mx-auto flex flex-col-reverse items-center justify-between py-8 md:py-20 lg:flex-row"
>
  <div class="sr-only sm:not-sr-only">
    <p class={cn("font-medium text-gray-dark", lang === "uk" ? "text-[1.75rem]" : "text-4xl")}>
      {t("hero.subheadline")}
    </p>
    <h1
      class={cn(
        "text-4xl font-medium",
        lang === "uk" ? "max-w-xl leading-none lg:text-[3.25rem]" : "max-w-xl lg:text-6xl",
      )}
    >
      {t("hero.headline")}
    </h1>
    <p class="mt-6 max-w-md text-lg">
      {t("hero.description")}
    </p>
    <Button className="mt-9">{t("common.cta")}</Button>
  </div>
  <div>
    <RiveAnimation
      client:load
      src="/animations/hero-robot.riv"
      width={500}
      height={500}
    >
      <Image
        src={heroRobotPreview}
        alt="Hero Robot Preview"
        width={500}
        height={500}
      />
    </RiveAnimation>
  </div>
  <div class="sm:hidden">
    <p class="font-medium text-gray-dark xl:text-4xl">
      {t("hero.subheadline")}
    </p>
    <p class="text-3xl font-medium xl:text-6xl">
      {t("hero.headline")}
    </p>
    <Image
      src={heroRobotPreview}
      alt="Hero Robot Preview"
      width={500}
      height={500}
    />
    <p class="mt-6 max-w-lg">
      {t("hero.description")}
    </p>
    <Button className="mt-9 w-full">{t("common.cta")}</Button>
  </div>
</section>

<ServicesCarousel client:load />
