---
import { Image } from "astro:assets";
import Section from "../common/Section.astro";
import arrowLeft from "@/assets/icons/arrow-left.svg";
import arrowRight from "@/assets/icons/arrow-right.svg";
import automation from "@/assets/icons/automation.svg";
import support from "@/assets/icons/support.svg";
import webDev from "@/assets/icons/web-dev.svg";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import ServiceCard from "./ServiceCard.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Section title={t("services.title")} sectionId="services">
  <p slot="description" class="md:max-w-2xl">
    {t("services.description")}
  </p>

  <ServiceCard
    href={`/${lang}/implementation`}
    class="md:ml-auto"
    containerClass="z-20"
  >
    <Fragment slot="title">
      <span class="block">{t("services.automation.title.1")}</span>
      <span class="block">{t("services.automation.title.2")}</span>
    </Fragment>
    <Fragment slot="illustration">
      <Image
        src={automation}
        alt="Automatization Illustration"
        width="192"
        height="192"
      />
    </Fragment>
    <Fragment slot="arrow">
      <Image
        src={arrowLeft}
        alt="Arrow Left"
        class="absolute right-[99%] top-1/2 z-10 hidden xl:block"
      />
    </Fragment>
  </ServiceCard>
  <ServiceCard href={`/${lang}/automation-support`} class="mt-[75px]">
    <Fragment slot="title">
      <span class="block w-fit rounded-md bg-grey-light px-2"
        >{t("services.support.title.1")}</span
      >
      <span class="inline-block rounded-md bg-grey-light px-2"
        >{t("services.support.title.2")}</span
      >
    </Fragment>
    <Fragment slot="illustration">
      <Image
        src={support}
        alt="Support Illustration"
        width="200"
        height="200"
      />
    </Fragment>
    <Fragment slot="arrow">
      <Image
        src={arrowRight}
        alt="Arrow Left"
        class="absolute left-[99%] top-1/2 -z-10 hidden xl:block"
      />
    </Fragment>
  </ServiceCard>
  <ServiceCard
    href={`/${lang}/web-development`}
    variant="dark"
    class="ml-auto mt-[75px]"
  >
    <Fragment slot="title">
      <slot name="web-dev-title">
        <span class="md:hidden">
          <span class="block w-fit rounded-md bg-grey-light px-2">Custom</span>
          <span class="block w-fit rounded-md bg-grey-light px-2"
            >Web Development</span
          >
        </span>
        <span
          class="hidden w-fit whitespace-nowrap rounded-md bg-grey-light px-2 md:block"
          >Custom Web Development</span
        >
      </slot>
    </Fragment>
    <Fragment slot="illustration">
      <Image
        src={webDev}
        alt="Web Development Illustration"
        width="192"
        height="192"
      />
    </Fragment>
    <Fragment slot="arrow"> </Fragment>
  </ServiceCard>
</Section>
