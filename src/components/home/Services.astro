---
import { Image } from "astro:assets";
import Section from "../common/Section.astro";
import LinkArrow from "../icons/LinkArrow.astro";
import arrowLeft from "../../assets/icons/arrow-left.svg";
import arrowRight from "../../assets/icons/arrow-right.svg";
import automation from "../../assets/icons/automation.svg";
import support from "../../assets/icons/support.svg";
import webDev from "../../assets/icons/web-dev.svg";
---

<Section title="Services" sectionId="services">
  <p slot="description" class="md:max-w-lg">
    Tailored solutions to help businesses streamline operations, save time, and
    boost efficiency. Here’s how we can help:
  </p>
  <a href="#" class="relative block w-full md:ml-auto md:w-fit">
    <div
      class="relative z-20 flex w-full justify-between gap-10 rounded-smooth-large border border-grey-darker bg-primary p-12 shadow-[0_6px_0px_0px_rgba(0,0,0,1)] transition-all hover:-translate-y-1 hover:shadow-[0_6px_10px_0px_rgba(0,0,0,1)]"
    >
      <div class="flex flex-col justify-between">
        <h3 class="text-2xl font-medium md:text-3xl">
          <span class="block">Automation Discovery</span>
          <span class="block">Implementation & Optimization</span>
        </h3>
        <div class="flex items-center gap-3 text-xl">
          <LinkArrow />
          Learn more
        </div>
      </div>
      <Image
        src={automation}
        alt="Automatization Illustration"
        width="192"
        height="192"
      />
    </div>
    <Image
      src={arrowLeft}
      alt="Arrow Left"
      class="absolute right-[99%] top-1/2 z-10 hidden xl:block"
    />
  </a>
  <a href="#" class="relative mt-[75px] block md:w-fit">
    <div
      class="relative flex w-full justify-between gap-10 rounded-smooth-large border border-grey-darker bg-primary p-12 shadow-[0_6px_0px_0px_rgba(0,0,0,1)] transition-all hover:-translate-y-1 hover:shadow-[0_6px_10px_0px_rgba(0,0,0,1)]"
    >
      <div class="flex flex-col justify-between">
        <h3 class="hidden text-3xl font-medium md:inline">
          <span class="block rounded-md bg-grey-light px-2"
            >Automation Support</span
          >
          <span class="inline-block rounded-md bg-grey-light px-2"
            >& Maintenance</span
          >
        </h3>
        <h3 class="text-2xl font-medium md:hidden">
          <span class="inline-block rounded-md bg-grey-light px-2"
            >Automation</span
          >
          <br />
          <span class="inline-block rounded-md bg-grey-light px-2">Support</span
          >
          <br />
          <span class="inline-block rounded-md bg-grey-light px-2"
            >& Maintenance</span
          >
        </h3>
        <div class="flex items-center gap-3 text-xl">
          <LinkArrow />
          Learn more
        </div>
      </div>
      <Image
        src={support}
        alt="Automatization Illustration"
        width="192"
        height="192"
      />
    </div>
    <Image
      src={arrowRight}
      alt="Arrow Left"
      class="absolute left-[99%] top-1/2 -z-10 hidden xl:block"
    />
  </a>
  <a href="#" class="relative ml-auto mt-[75px] block md:w-fit">
    <div
      class="relative flex justify-between gap-10 rounded-smooth-large border border-grey-darker bg-grey-darker p-12 shadow-[0_6px_0px_0px_rgba(0,0,0,1)] transition-all hover:-translate-y-1 hover:shadow-[0_6px_10px_0px_rgba(0,0,0,1)] md:w-fit"
    >
      <div class="flex flex-col justify-between">
        <h3 class="hidden text-3xl font-medium md:inline">
          <span class="block rounded-md bg-grey-light px-2"
            >Custom Web Development</span
          >
        </h3>
        <h3 class="text-2xl font-medium md:hidden">
          <span class="inline-block rounded-md bg-grey-light px-2"
            >Custom Web</span
          >
          <span class="block rounded-md bg-grey-light px-2">Development</span>
        </h3>
        <div class="flex items-center gap-3 text-xl text-grey-light">
          <LinkArrow variant="light" />
          Learn more
        </div>
      </div>
      <Image
        src={webDev}
        alt="Automatization Illustration"
        width="192"
        height="192"
      />
    </div>
  </a>
</Section>
