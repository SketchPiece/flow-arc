---
// import { Image } from "astro:assets"
import { cn } from "@/lib/helpers";
import LinkArrow from "../icons/LinkArrow.astro";

import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  variant?: "light" | "dark";
  containerClass?: string;
  href?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { variant, containerClass, href, ...attrs } = Astro.props;
const isDark = variant === "dark";
---

<a
  href={href}
  class={cn("relative block w-full md:max-w-[630px]", attrs.class)}
>
  <div
    class={cn(
      "relative flex w-full flex-col-reverse items-center sm:flex-row justify-between gap-10 rounded-smooth-large border border-gray-darker p-12 shadow-straight transition-all hover:-translate-y-1 hover:shadow-straight-reduced",
      isDark ? "bg-gray-darker" : "bg-primary",
      containerClass,
    )}
  >
    <div class="flex flex-col gap-5 md:gap-16">
      <h3 class="font-medium sm:text-xl md:inline md:text-2xl">
        <slot name="title" />
      </h3>
      <div
        class={cn(
          "flex items-center gap-3 sm:text-xl",
          isDark && "text-gray-light",
        )}
      >
        <LinkArrow
          variant={isDark ? "light" : "dark"}
          class="h-6 w-6 sm:h-10 sm:w-10"
        />
        {t("common.learn-more")}
      </div>
    </div>
    <slot name="illustration" />
  </div>
  <slot name="arrow" />
</a>
