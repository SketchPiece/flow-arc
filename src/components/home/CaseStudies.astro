---
import { cn } from "@/lib/helpers";
import Section from "../common/Section.astro";
import LinkArrow from "../icons/LinkArrow.astro";

import { getLangFromUrl, useTranslations } from "@/i18n/helpers";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cases = [
  {
    title: t("case-studies.case.1"),
    href: "#restaurant-case",
  },
  {
    title: t("case-studies.case.2"),
    href: "#b2b-case",
  },
  {
    title: t("case-studies.case.3"),
    href: "#retail-case",
  },
];
---

<Section title={t("case-studies.title")} sectionId="case-studies">
  <p
    slot="description"
    class={cn(lang === "uk" ? "md:max-w-2xl" : "md:max-w-md")}
  >
    {t("case-studies.description")}
  </p>

  <div
    class="grid grid-cols-1 gap-8 divide-y divide-grey-light rounded-smooth-large bg-grey-darker px-9 py-16 text-grey-light sm:px-14 md:grid-cols-3 md:divide-x md:divide-y-0"
  >
    {
      cases.map((item, index) => (
        <div class:list={[index !== 0 && "pt-8 md:pl-8 md:pt-0"]}>
          <p class="mb-6 text-grey-light">{item.title}</p>
          <a
            href={item.href}
            class="inline-flex items-center text-primary transition-colors hover:text-primary-darker"
          >
            {t("common.learn-more")}
            <LinkArrow variant="transparent" />
          </a>
        </div>
      ))
    }
  </div>
</Section>
