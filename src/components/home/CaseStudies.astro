---
import { cn } from "@/lib/helpers";
import Section from "../common/Section.astro";
import LinkArrow from "../icons/LinkArrow.astro";

import { getLangFromUrl, useTranslations } from "@/i18n/helpers";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface CaseStudy {
  title: string;
  description: string | undefined;
  href: string;
}

interface Props {
  cases: CaseStudy[];
}

const { cases } = Astro.props;
---

<Section title={t("case-studies.title")} sectionId="case-studies">
  <p
    slot="description"
    class={cn(lang === "uk" ? "md:max-w-2xl" : "md:max-w-md")}
  >
    {t("case-studies.description")}
  </p>

  <div
    class="grid grid-cols-1 gap-8 divide-y divide-gray-light rounded-smooth-large bg-gray-darker px-8 py-12 text-gray-light sm:px-12 md:grid-cols-3 md:divide-x md:divide-y-0"
  >
    {
      cases.map((item, index) => (
        <div
          class:list={[
            index !== 0 && "pt-6 md:pl-6 md:pt-0",
            "flex flex-col justify-between",
          ]}
        >
          <div>
            <h3 class="mb-4 text-2xl font-medium">{item.title}</h3>
            <p class="mb-6 text-gray-light">{item.description}</p>
          </div>
          <a
            href={item.href}
            class="inline-flex items-center text-primary transition-colors hover:text-primary-darker"
          >
            {t("common.learn-more")}
            <LinkArrow variant="transparent" />
          </a>
        </div>
      ))
    }
  </div>
</Section>
