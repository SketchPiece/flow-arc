---
interface Props {
  title: string;
  sectionId?: string;
}

const { title, sectionId } = Astro.props;
---

<section id={sectionId} class="container mx-auto py-20">
  <div
    class="flex flex-col items-center justify-center gap-8 md:flex-row md:justify-start"
  >
    <div class="inline-block rounded-md bg-primary px-2 text-4xl font-medium">
      <h2>
        {title}
      </h2>
    </div>
    <div class="text-center md:text-left">
      <slot name="description" />
    </div>
  </div>
  <div class="pt-10 sm:pt-20">
    <slot />
  </div>
</section>
