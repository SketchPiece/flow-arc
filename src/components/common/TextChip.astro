---
import { cn } from "@/lib/helpers";
import { Image } from "astro:assets";

interface Props {
  text: string;
  icon: ImageMetadata;
  isDark?: boolean;
}

const { text, icon, isDark } = Astro.props;
---

<div
  class={cn(
    "flex gap-5 py-8 px-14 items-center rounded-smooth-large border border-gray-darkest shadow-straight transition-all hover:-translate-y-1 hover:shadow-straight-reduced",
    isDark ? "bg-gray-darker text-gray-light" : "bg-primary text-gray-darkest ",
  )}
>
  <Image src={icon} alt={`text icon`} />
  <p class="text-xl font-medium md:text-2xl">
    {text}
  </p>
</div>
