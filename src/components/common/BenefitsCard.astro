---
import { Image } from "astro:assets";
import { cn } from "../../lib/utils";

import checkmarkLight from "../../assets/icons/checkmark-white-dark.svg";
import checkmarkDark from "../../assets/icons/checkmark-blue-dark.svg";

interface Props {
  title: string;
  items: string[];
  image?: ImageMetadata;
  isDark?: boolean;
  className?: string;
}

const { title, items, isDark, image, className } = Astro.props;
---

<div
  class={cn(
    "flex flex-1 lg:flex-row flex-col xl:gap-14 lg:gap-3 gap-5 items-center justify-between lg:pl-10 lg:pr-5 px-3 xl:px-13 py-14 rounded-smooth-large w-full border border-black shadow-straight-small",
    isDark ? "bg-grey-darker" : "bg-primary",
    className,
  )}
>
  <div class="flex flex-col gap-9">
    <h3
      class="w-fit rounded bg-grey-light px-2 text-2xl font-medium text-grey-darkest"
    >
      {title}
    </h3>
    <ul
      class={cn(
        "grid justify-between gap-6",
        !!image ? "grid-cols-1" : "xl:grid-cols-2",
      )}
    >
      {
        items.map((item) => (
          <li
            class={cn(
              "flex items-center gap-4 text-lg font-medium",
              isDark ? "text-grey-light" : "text-grey-darkest",
            )}
          >
            <Image
              src={isDark ? checkmarkDark : checkmarkLight}
              alt="checkmark"
            />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
  {!!image && <Image src={image} alt={`benefits-card ${title} image`} />}
</div>
