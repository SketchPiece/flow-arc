---
import { Image } from "astro:assets";
import { cn } from "@/lib/helpers";
import Checkmark from "../icons/Checkmark.astro";

interface Props {
  title: string;
  items: string[];
  image?: ImageMetadata;
  isDark?: boolean;
  className?: string;
  lastPlus?: boolean;
}

const { title, items, isDark, image, lastPlus, className } = Astro.props;
---

<div
  class={cn(
    "flex flex-1 md:flex-row flex-col-reverse lg:gap-14 md:gap-3 gap-5 items-center justify-between md:pl-10 md:pr-16 lg:pr-5 px-3 lg:px-13 py-14 rounded-smooth-large w-full border border-black shadow-straight transition-all hover:-translate-y-1 hover:shadow-straight-reduced",
    isDark ? "bg-gray-darker" : "bg-primary",
    className,
  )}
>
  <div class="flex flex-col gap-9">
    <h3
      class="bg-gray-light text-gray-darkest w-fit rounded px-2 text-2xl font-medium"
    >
      {title}
    </h3>
    <ul
      class={cn(
        "grid justify-between gap-6",
        !!image ? "grid-cols-1" : "md:grid-cols-2",
      )}
    >
      {
        items.map((item, index) => {
          const isLast = index === items.length - 1;
          const type = lastPlus ? (isLast ? "plus" : "checkmark") : "checkmark";
          return (
            <li
              class={cn(
                "flex items-center gap-4 text-base font-medium",
                isDark ? "text-gray-light" : "text-gray-darkest",
              )}
            >
              <Checkmark variant={isDark ? "dark" : "light"} type={type} />
              {item}
            </li>
          );
        })
      }
    </ul>
  </div>
  {!!image && <Image src={image} alt={`benefits-card ${title} image`} />}
</div>
