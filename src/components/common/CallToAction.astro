---
import { Image } from "astro:assets";
import Button from "../react/ui/Button";
import chatBot from "@/assets/images/little-chatbot.png";
import chess from "@/assets/images/chess.png";

interface Props {
  title: string;
  buttonLabel: string;
  type?: "chess" | "bot";
}

const { title, buttonLabel, type } = Astro.props;
---

<section class="container mx-auto pb-20">
  <div
    class="flex justify-between gap-8 rounded-smooth-large bg-primary px-9 py-11 sm:px-14"
  >
    <div class="flex flex-col justify-between">
      <div class="space-y-6">
        <h3 class="text-xl font-medium sm:text-3xl">
          {title}
        </h3>
        <slot name="description" />
      </div>
      <Button className="mt-6 w-full sm:w-fit">{buttonLabel}</Button>
    </div>

    <Image
      src={type === "chess" ? chess : chatBot}
      alt="Chess Illustration"
      height={250}
      class="hidden lg:block"
    />
  </div>
</section>
