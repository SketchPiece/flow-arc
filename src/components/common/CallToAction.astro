---
import { Image } from "astro:assets";
import chatBot from "@/assets/images/little-chatbot.png";
import chess from "@/assets/images/chess.png";
import { cn } from "@/lib/helpers";
import BookConsultation from "../react/BookConsultation";
import { getLangFromUrl } from "@/i18n/helpers";

interface Props {
  title: string;
  buttonLabel: string;
  type?: "chess" | "bot";
  className?: string;
}

const lang = getLangFromUrl(Astro.url);
const { title, buttonLabel, type, className } = Astro.props;
---

<section class={cn("container mx-auto pb-20", className)}>
  <div
    class="flex justify-between gap-8 rounded-smooth-large bg-primary px-8 py-10 sm:px-12"
  >
    <div class="flex flex-col justify-between">
      <div class="space-y-6">
        <h3 class="text-xl font-medium sm:text-3xl">
          {title}
        </h3>
        <slot name="description" />
      </div>
      <BookConsultation client:load lang={lang} className="mt-6 w-full sm:w-fit">{buttonLabel}</BookConsultation>
    </div>

    <Image
      src={type === "chess" ? chess : chatBot}
      alt="Chess Illustration"
      height={240}
      class="hidden lg:block"
    />
  </div>
</section>
