---
import { Image } from "astro:assets";
import Button from "../react/ui/Button";
import chess from "@/assets/icons/chess.svg";

import { getLangFromUrl, useTranslations } from "@/i18n/helpers";

interface Props {
  title: string;
}

const { title } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="container mx-auto pb-20">
  <div
    class="flex justify-between gap-8 rounded-smooth-large bg-primary px-14 py-11"
  >
    <div class="space-y-6">
      <h3 class="text-3xl font-medium">
        {title}
      </h3>
      <slot name="description" />
      <Button>{t("common.cta")}</Button>
    </div>

    <Image
      src={chess}
      alt="Chess Illustration"
      height={250}
      class="hidden lg:block"
    />
  </div>
</section>
