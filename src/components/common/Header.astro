---
import logoIcon from "@/assets/icons/logo.svg";
import ukFlag from "@/assets/icons/uk.svg";
import gbFlag from "@/assets/icons/gb.svg";
import MobileMenu from "../react/MobileMenu";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import { Image } from "astro:assets";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navigationLinks = [
  { name: t("nav.about"), href: `/${lang}/about` },
  { name: t("nav.services"), href: `/${lang}/services` },
  { name: t("nav.case-studies"), href: `/${lang}/case-studies` },
  { name: t("nav.blog"), href: `/${lang}/blog` },
];
---

<header class="pt-10 font-serif">
  <nav
    aria-label="Global"
    class="container mx-auto flex items-center justify-between"
  >
    <a href="/">
      <span class="sr-only">Flow Arc</span>
      <img alt="Flow Arc Logo" src={logoIcon.src} class="h-12" />
    </a>
    <MobileMenu navigation={navigationLinks} client:load />
    <div class="hidden lg:flex lg:gap-x-12">
      {
        navigationLinks.map((item) => (
          <a href={item.href} class="text-lg hover:text-primary-darker">
            {item.name}
          </a>
        ))
      }
      <a
        href={lang === "uk" ? "/en" : "/uk"}
        class="text-lg hover:text-primary-darker"
      >
        <Image
          src={lang === "uk" ? ukFlag : gbFlag}
          alt="Language Flag"
          width="28"
          height="28"
        />
      </a>
    </div>
  </nav>
</header>
