---
import logoIcon from "@/assets/icons/logo.svg";
import ukFlag from "@/assets/icons/uk.svg";
import gbFlag from "@/assets/icons/gb.svg";
import MobileMenu from "../react/MobileMenu";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import { Image } from "astro:assets";
import PopoverMenu from "../react/PopoverMenu";
import { getCasesCollection } from "@/lib/content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    name: t("nav.services.implementation.title"),
    href: `/${lang}/implementation`,
    description: t("nav.services.implementation.description"),
  },
  {
    name: t("nav.services.automation-support.title"),
    href: `/${lang}/automation-support`,
    description: t("nav.services.automation-support.description"),
  },
  {
    name: t("nav.services.web-development.title"),
    href: `/${lang}/web-development`,
    description: t("nav.services.web-development.description"),
  },
];

const cases = await getCasesCollection({ lang });
const caseStudies = cases.map((caseStudy) => {
  return {
    name: caseStudy.title,
    href: `/${lang}/case-studies/${caseStudy.slug}`,
  };
});

const navigationLinks = [
  { name: t("nav.about"), href: `/${lang}/about` },
  { name: t("nav.services"), items: services },
  { name: t("nav.case-studies"), items: caseStudies },
  { name: t("nav.blog"), href: `/${lang}/blog` },
];

const pagePath = Astro.url.pathname.replace(`/${lang}`, "");
const changeLanguagePath = lang === `uk` ? `/en${pagePath}` : `/uk${pagePath}`;
---

<header class="pt-8 font-serif">
  <nav
    aria-label="Global"
    class="container mx-auto flex items-center justify-between"
  >
    <a href={`/${lang}`}>
      <span class="sr-only">Flow Arc</span>
      <img alt="Flow Arc Logo" src={logoIcon.src} class="h-10" />
    </a>
    <MobileMenu
      navigation={navigationLinks}
      language={lang}
      languagePath={changeLanguagePath}
      client:load
    />
    <div class="hidden lg:flex lg:gap-x-10">
      <a href={`/${lang}/about`} class="text-lg hover:text-primary-darker">
        {t("nav.about")}
      </a>
      <PopoverMenu
        client:load
        className="text-lg hover:text-primary-darker"
        items={services}
      >
        {t("nav.services")}
      </PopoverMenu>
      <PopoverMenu
        client:load
        className="text-lg hover:text-primary-darker"
        items={caseStudies}
      >
        {t("nav.case-studies")}
      </PopoverMenu>
      <a href={`/${lang}/blog`} class="text-lg hover:text-primary-darker">
        {t("nav.blog")}
      </a>
      <a href={changeLanguagePath} class="text-lg hover:text-primary-darker grid place-items-center">
        <Image
          src={lang === "uk" ? ukFlag : gbFlag}
          alt="Language Flag"
          width="24"
          height="24"
        />
      </a>
    </div>
  </nav>
</header>
