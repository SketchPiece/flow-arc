---
import { cn } from "@/lib/helpers";

interface Props {
  title: string;
  subTitle: string;
  className?: string;
}

const { title, subTitle, className } = Astro.props;
---

<div class="container mx-auto">
  <div
    id="default-heading"
    class={cn(
      "flex flex-col items-center justify-center rounded-smooth-large bg-grey-darkest px-6 md:px-12 py-10 border border-grey-darkest shadow-[0_6px_0px_0px_rgba(0,0,0,1)]",
      className
    )}
  >
    <h3
      class="rounded bg-grey-light p-1 px-2 text-center text-3xl font-medium text-grey-darkest md:py-0"
    >
      {title}
    </h3>
    <p class="mt-5 text-center text-xl text-grey-light md:max-w-4xl">
      {subTitle}
    </p>
  </div>
</div>
