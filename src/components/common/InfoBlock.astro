---
import { cn } from "@/lib/helpers";

interface Props {
  title: string;
  subtitle: string;
  className?: string;
}

const { title, subtitle, className } = Astro.props;
---

<div class="container mx-auto">
  <div
    id="default-heading"
    class={cn(
      "flex flex-col items-center justify-center rounded-smooth-large bg-gray-darkest px-6 md:px-12 py-10 border border-gray-darkest shadow-straight",
      className,
    )}
  >
    <h3
      class="bg-gray-light text-gray-darkest rounded p-1 px-2 text-center text-lg font-medium md:py-0 lg:text-3xl"
    >
      {title}
    </h3>
    <p
      class="text-gray-light mt-5 text-center text-base md:max-w-4xl lg:text-xl"
    >
      {subtitle}
    </p>
  </div>
</div>
