---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { cn } from "../../lib/utils";
import arrowInRight from "../../assets/images/arrow-in-right.png";
import arrowInLeft from "../../assets/images/arrow-in-left.png";

interface Props {
  direction: "right" | "left";
  cards: {
    title: string;
    subTitle: string;
    image: ImageMetadata;
    focused?: boolean;
  }[];
  className?: string;
}

const { cards, direction, className } = Astro.props;
---

<section id="cards-flow-list" class={cn("container mx-auto", className)}>
  <div class="flex w-full flex-col">
    {
      cards?.map(({ title, subTitle, image }, index) => {
        const isLeftCard =
          !index || index % 2 === 0
            ? direction === "right"
            : direction === "left";
        const isFirst = !index;
        const isLast = index === cards?.length - 1;

        return (
          <div
            class={cn(
              "shadow-straight-small relative flex w-full flex-col justify-between gap-10 overflow-x-hidden rounded-smooth-large border border-grey-darkest px-14 py-12 sm:flex-col-reverse sm:overflow-y-hidden md:flex-row lg:flex-row lg:overflow-y-visible xl:w-[768px] xl:overflow-x-visible",
              isLast
                ? "mt-12 bg-grey-darkest text-grey-light"
                : "mt-20 bg-primary text-grey-darkest",
              isLeftCard ? "xl:ml-20 xl:mr-auto" : "xl:ml-auto xl:mr-20",
            )}
          >
            <div class="flex flex-col gap-10">
              <h2
                class={cn(
                  "text-5xl font-medium text-grey-darkest",
                  isLast && "w-fit rounded bg-grey-light px-2",
                )}
              >
                {title}
              </h2>
              <h3 class="text-3xl font-medium text-inherit">{subTitle}</h3>
            </div>
            <Image src={image} alt={`card ${title} image`} />
            {!isFirst && (
              <Image
                class={cn(
                  "absolute -top-[45%] -z-10 sm:opacity-0 xl:opacity-100",
                  isLeftCard ? "-right-[45%]" : "-left-[40%]",
                )}
                src={isLeftCard ? arrowInLeft : arrowInRight}
                alt="arrow"
              />
            )}
          </div>
        );
      })
    }
  </div>
</section>
