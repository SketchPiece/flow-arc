---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { cn } from "@/lib/helpers";
import arrowInRight from "@/assets/images/arrow-in-right.png";
import arrowInLeft from "@/assets/images/arrow-in-left.png";

interface Props {
  // direction: "right" | "left";
  cards: {
    title: string;
    subtitle: string;
    image: ImageMetadata;
    focused?: boolean;
  }[];
  className?: string;
}

const { cards } = Astro.props;
---

<div class="flex w-full flex-col">
  {
    cards?.map(({ title, subtitle, image }, index) => {
      const isLeftCard = index === 0 || index % 2 === 0;
      const isFirst = index === 0;
      const isLast = index === cards?.length - 1;
      const zIndex = (cards?.length - index) * 10;

      return (
        <div class="relative">
          <div
            class={cn(
              "relative flex w-full flex-col-reverse justify-between gap-4 overflow-y-hidden rounded-smooth-large border border-gray-darkest px-6 py-10 shadow-straight transition-all hover:-translate-y-1 hover:shadow-straight-reduced md:flex-row md:gap-0 md:px-10 md:py-10 lg:flex-row lg:overflow-y-visible xl:w-[768px] xl:overflow-x-visible",
              isLast
                ? "bg-gray-darker text-gray-light"
                : "bg-primary text-gray-darker",
              !isFirst && "mt-8 md:mt-12",
              isLeftCard ? "mr-auto" : "ml-auto",
            )}
            style={{ zIndex }}
          >
            <div class="flex flex-col gap-5 md:gap-10">
              <h2
                class={cn(
                  "text-3xl font-medium text-gray-darkest md:text-5xl",
                  (isLast || !isLeftCard) && "w-fit rounded bg-gray-light px-2",
                )}
              >
                {title}
              </h2>
              <p class="text-2xl font-medium text-inherit md:max-w-xs md:text-3xl">
                {subtitle}
              </p>
            </div>
            <div class="grid place-items-center">
              <Image
                src={image}
                alt={`card ${title} image`}
                height={220}
                class="h-auto max-h-36 w-auto"
              />
            </div>
          </div>
          {!isFirst && (
            <Image
              class={cn(
                "absolute -top-[20px] hidden xl:block",
                isLeftCard ? "right-[00px]" : "left-[30px]",
              )}
              src={isLeftCard ? arrowInLeft : arrowInRight}
              alt="arrow"
              style={{ zIndex: zIndex }}
            />
          )}
        </div>
      );
    })
  }
</div>
