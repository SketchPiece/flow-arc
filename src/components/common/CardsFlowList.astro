---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { cn } from "@/lib/helpers";
import arrowInRight from "@/assets/images/arrow-in-right.png";
import arrowInLeft from "@/assets/images/arrow-in-left.png";

interface Props {
  // direction: "right" | "left";
  cards: {
    title: string;
    subTitle: string;
    image: ImageMetadata;
    focused?: boolean;
  }[];
  className?: string;
}

const { cards } = Astro.props;
---

<div class="flex w-full flex-col">
  {
    cards?.map(({ title, subTitle, image }, index) => {
      const isLeftCard = index === 0 || index % 2 === 0;
      const isFirst = index === 0;
      const isLast = index === cards?.length - 1;
      const zIndex = (cards?.length - index) * 10;

      return (
        <div class="relative">
          <div
            class={cn(
              "relative flex w-full flex-col-reverse justify-between overflow-y-hidden rounded-smooth-large border border-grey-darkest px-14 py-12 shadow-[0_6px_0px_0px_rgba(0,0,0,1)] transition-all hover:-translate-y-1 hover:shadow-[0_6px_10px_0px_rgba(0,0,0,1)] md:flex-row lg:flex-row lg:overflow-y-visible xl:w-[768px] xl:overflow-x-visible",
              isLast
                ? "bg-grey-darkest text-grey-light"
                : "bg-primary text-grey-darkest",
              !isFirst && "mt-8 md:mt-12",
              isLeftCard ? "mr-auto" : "ml-auto"
            )}
            style={{ zIndex }}
          >
            <div class="flex flex-col gap-10">
              <h2
                class={cn(
                  "text-5xl font-medium text-grey-darkest",
                  isLast && "w-fit rounded bg-grey-light px-2"
                )}
              >
                {title}
              </h2>
              <p class="text-3xl font-medium text-inherit md:max-w-xs">
                {subTitle}
              </p>
            </div>
            <div class="grid place-items-center">
              <Image
                src={image}
                alt={`card ${title} image`}
                class="h-auto w-auto"
              />
            </div>
          </div>
          {!isFirst && (
            <Image
              class={cn(
                "absolute -top-[20px] hidden xl:block",
                isLeftCard ? "right-[169px]" : "left-[215px]"
              )}
              src={isLeftCard ? arrowInLeft : arrowInRight}
              alt="arrow"
              style={{ zIndex: zIndex }}
            />
          )}
        </div>
      );
    })
  }
</div>
