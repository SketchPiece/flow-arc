---
import logoIcon from "@/assets/icons/logo-dark.svg";
import linkedinIcon from "@/assets/icons/linkedin.svg";
import xtwitterIcon from "@/assets/icons/xtwitter.svg";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navigationLinks = [
  { name: t("nav.about"), href: `/${lang}/about` },
  { name: t("nav.services"), href: `/${lang}/services` },
  { name: t("nav.case-studies"), href: `/${lang}/case-studies` },
  { name: t("nav.blog"), href: `/${lang}/blog` },
];
---

<div class="mx-auto md:container">
  <footer
    class="rounded-t-smooth-large bg-gray-darker px-14 py-16 text-gray-lighter"
  >
    <nav aria-label="Global" class="flex items-center justify-between">
      <a href="/">
        <span class="sr-only">FlowArc</span>
        <img alt="flow-arc-logo-footer" src={logoIcon.src} class="h-12" />
      </a>

      <div class="hidden lg:flex lg:gap-x-10">
        {
          navigationLinks.map((item) => (
            <a
              href={item.href}
              class="font-serif text-lg font-thin underline hover:text-primary"
            >
              {item.name}
            </a>
          ))
        }
      </div>
      <div class="flex justify-end gap-5">
        <a href="/">
          <img alt="flow-arc-logo-footer" src={linkedinIcon.src} />
        </a>
        <a href="/">
          <img alt="flow-arc-logo-footer" src={xtwitterIcon.src} />
        </a>
      </div>
    </nav>
    <div class="mb-12 mt-16 flex flex-col gap-5 font-serif text-lg font-thin">
      <h4
        class="mt-1.5 w-fit rounded-lg bg-primary px-1.5 font-medium text-gray-darkest"
      >
        {t("contact-us.title")}
      </h4>
      <p>Email: info@flowarc.dev</p>

      <p>Telegram: @flowarc</p>
    </div>
    <div
      class="flex flex-col justify-between gap-4 border-t pt-12 font-serif text-lg font-thin md:flex md:flex-row"
    >
      <span class="mr-10">© 2025 FlowArc. All Rights Reserved.</span>
      <div>
        <a href={`/${lang}/terms-of-service`} class="ml-auto p-0 underline">
          {t("footer.terms-of-service")}
        </a>
        <a href={`/${lang}/privacy-policy`} class="p-0 pl-8 underline">
          {t("footer.privacy-policy")}
        </a>
      </div>
    </div>
  </footer>
</div>
