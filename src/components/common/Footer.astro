---
import logoIcon from "@/assets/icons/logo-dark.svg";
import linkedinIcon from "@/assets/icons/linkedin.svg";
// import xtwitterIcon from "@/assets/icons/xtwitter.svg";
import { getLangFromUrl, useTranslations } from "@/i18n/helpers";
import PopoverMenu from "../react/PopoverMenu";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    name: t("nav.services.implementation.title"),
    href: `/${lang}/implementation`,
    description: t("nav.services.implementation.description"),
  },
  {
    name: t("nav.services.automation-support.title"),
    href: `/${lang}/automation-support`,
    description: t("nav.services.automation-support.description"),
  },
  {
    name: t("nav.services.web-development.title"),
    href: `/${lang}/web-development`,
    description: t("nav.services.web-development.description"),
  },
];
---

<div class="mx-auto md:container">
  <footer
    class="rounded-t-smooth-large bg-gray-darker px-14 py-12 text-gray-lighter"
  >
    <nav aria-label="Global" class="flex items-center justify-between">
      <a href="/">
        <span class="sr-only">Flow Arc</span>
        <img alt="flow-arc-logo-footer" src={logoIcon.src} class="h-10" />
      </a>

      <div class="hidden lg:flex lg:gap-x-10">
        <a
          href={`/${lang}/about`}
          class="font-thin underline hover:text-primary"
        >
          {t("nav.about")}
        </a>
        <PopoverMenu
          client:load
          className="font-thin underline hover:text-primary"
          items={services}
          align="top"
        >
          {t("nav.services")}
        </PopoverMenu>
        <a
          href={`/${lang}/case-studies`}
          class="font-thin underline hover:text-primary"
        >
          {t("nav.case-studies")}
        </a>
        <a
          href={`/${lang}/blog`}
          class="font-thin underline hover:text-primary"
        >
          {t("nav.blog")}
        </a>
      </div>
      <div class="flex justify-end gap-5">
        <a href="https://www.linkedin.com/" target="_blank" class="pl-10">
          <img alt="flow-arc-logo-footer" src={linkedinIcon.src} />
        </a>
        <!-- <a href="/">
          <img alt="flow-arc-logo-footer" src={xtwitterIcon.src} />
        </a> -->
      </div>
    </nav>
    <div class="mb-12 mt-16 flex flex-col gap-5 font-serif font-thin">
      <h4
        class="mt-1.5 w-fit rounded-lg bg-primary px-1.5 text-lg font-medium text-gray-darkest"
      >
        {t("contact-us.title")}
      </h4>
      <div class="grid gap-2">
        <p><span class="font-semibold">{t("footer.email")}</span><br>contact@flowarc.dev</p>
        <p><span class="font-semibold">{t("footer.phone")}</span><br>+380XXXXXXXXX (WhatsApp)</p>
      </div>
    </div>
    <div
      class="flex flex-col justify-between gap-4 border-t pt-12 font-serif font-thin md:flex md:flex-row"
    >
      <span class="mr-10">© 2025 FlowArc. All Rights Reserved.</span>
      <div>
        <a href={`/${lang}/terms-of-service`} class="ml-auto p-0 underline">{t("footer.terms-of-service")}</a>
        <a href={`/${lang}/privacy-policy`} class="p-0 pl-8 underline">{t("footer.privacy-policy")}</a>
      </div>
    </div>
  </footer>
</div>
