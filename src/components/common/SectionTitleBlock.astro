---
import { cn } from "../../lib/utils";

interface Props {
  title: string;
  subTitle: string;
  className?: string;
}

const { title, subTitle, className } = Astro.props;
---

<div class={cn("flex items-center gap-10 sm:flex-col lg:flex-row", className)}>
  <h2
    class="w-fit text-nowrap rounded bg-primary px-2 text-5xl font-medium text-black"
  >
    {title}
  </h2>
  <p class="text-lg text-black">{subTitle}</p>
</div>
