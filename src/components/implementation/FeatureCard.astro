---
import { cn } from "@/lib/helpers";
import Checkmark from "../icons/Checkmark.astro";

interface Props {
  title: string;
  features: string[];
  light?: boolean;
}

const { title, features, light } = Astro.props;
---

<div
  class={cn(
    "bg-gray-darkest rounded-smooth-large shadow-straight transition-all hover:-translate-y-1 hover:shadow-straight-reduced py-12 px-9 border border-gray-darkest",
    light && "bg-primary",
  )}
>
  <h3
    class="bg-gray-light text-gray-darkest inline-block rounded px-1 text-xl font-medium md:py-0 lg:text-xl"
  >
    {title}
  </h3>
  <ul
    class={cn(
      "mt-6 space-y-5 text-gray-lighter ",
      light && "text-gray-darkest font-medium",
    )}
  >
    {
      features.map((feature) => (
        <li class="flex items-center gap-3 text-sm">
          <Checkmark variant={light ? "light" : "dark"} type="checkmark" />
          {feature}
        </li>
      ))
    }
  </ul>
</div>
