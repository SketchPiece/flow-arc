---
import { cn } from "@/lib/helpers";

interface Props {
  content: string;
  variant: "left" | "right";
}

const { content, variant } = Astro.props;
---

<div
  class={cn(
    "py-8 px-14 rounded-smooth-large border border-grey-darkest w-fit shadow-straight",
    variant === "left"
      ? "bg-grey-darkest text-grey-light rounded-bl-md"
      : "bg-primary ml-auto rounded-br-md"
  )}
>
  <p class="font-medium md:text-2xl">{content}</p>
</div>
