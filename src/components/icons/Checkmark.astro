---
interface Props {
  variant: "light" | "dark" | "primary";
  type?: "checkmark" | "plus";
}

function defineColors(variant: "light" | "dark" | "primary") {
  switch (variant) {
    case "light":
      return {
        fill: "#FFFFFF",
        stroke: "#000000",
      };
    case "dark":
      return {
        fill: "#ACD0F4",
        stroke: "#FFFFFF",
      };
    case "primary":
      return {
        fill: "#ACD0F4",
        stroke: "#000000",
      };
  }
}

const { variant, type } = Astro.props;

const colors = defineColors(variant);
