---
import type { TypedObject, Props as $ } from "astro-portabletext/types";
import { usePortableText } from "astro-portabletext";
import Table from "./Table.astro";
import PortableImage from "./PortableImage.astro";

type Props = $<TypedObject>;

const props = Astro.props;
const { getDefaultComponent } = usePortableText(props.node);
const typeIs = (type: string) => type === props.node._type;

const Cmp = typeIs("table") ? Table : typeIs("image") ? PortableImage : getDefaultComponent();
---

<Cmp {...props} />